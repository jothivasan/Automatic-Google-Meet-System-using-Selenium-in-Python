# .gitignore for Google Meet Automation System

# Environment variables (contains sensitive credentials)
.env

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environment
venv/
env/
ENV/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
meet_automation.log

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Browser data
.wdm/
chromedriver.exe
geckodriver.exe

# Screenshots (if debugging)
*.png
screenshots/

# Temporary files
*.tmp
temp/

# Distribution / packaging
build/
dist/
*.egg-info/
